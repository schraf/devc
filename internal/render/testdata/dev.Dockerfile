# syntax=docker/dockerfile:1
# Generated by devc from dev (dev.yaml). Edit the YAML, not this file.
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl git gnupg tzdata less locales man-db \
        openssh-client procps unzip wget zip sudo btop build-essential \
        make jq iptables fd-find fish ripgrep tmux vim \
        zoxide \
    && update-ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# --- atlassian-cli ---
# Atlassian CLI (acli), from the official "latest" tarball. Upstream publishes no checksums
# and no versioned URLs, so there is nothing to verify or pin: every rebuild that re-runs
# this layer picks up the newest release.
RUN set -eux; \
    file=acli_linux_arm64.tar.gz; \
    cd /tmp; \
    curl -fsSLO "https://acli.atlassian.com/linux/latest/$file"; \
    tar -xzf "$file"; \
    install -o root -g root -m 0755 acli_*_linux_*/acli /usr/local/bin/acli; \
    rm -rf "$file" acli_*_linux_*; \
    acli --version

# --- docker-in-docker ---
# Docker Engine (daemon + CLI + buildx + compose) from Docker's official repo
RUN install -m 0755 -d /etc/apt/keyrings \
    && . /etc/os-release \
    && curl -fsSL https://download.docker.com/linux/$ID/gpg -o /etc/apt/keyrings/docker.asc \
    && chmod a+r /etc/apt/keyrings/docker.asc \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/$ID $VERSION_CODENAME stable" \
        > /etc/apt/sources.list.d/docker.list \
    && apt-get update && apt-get install -y --no-install-recommends \
        docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin \
    && rm -rf /var/lib/apt/lists/*

# --- fd ---
# Debian/Ubuntu ship fd as fdfind
RUN ln -sf /usr/bin/fdfind /usr/local/bin/fd

# --- fzf ---
# fzf (Ubuntu's apt build is too old for `fzf --fish`)
RUN curl -fsSL https://github.com/junegunn/fzf/releases/download/v0.74.5/fzf-0.74.5-linux_arm64.tar.gz \
        | tar -xz -C /usr/local/bin fzf \
    && chmod 755 /usr/local/bin/fzf

# --- gcloud ---
# Google Cloud CLI (gcloud, gsutil, bq) from Google's apt repo — bundles its own Python
RUN curl -fsSL https://packages.cloud.google.com/apt/doc/apt-key.gpg \
        | gpg --dearmor -o /usr/share/keyrings/cloud.google.gpg \
    && echo "deb [signed-by=/usr/share/keyrings/cloud.google.gpg] https://packages.cloud.google.com/apt cloud-sdk main" \
        > /etc/apt/sources.list.d/google-cloud-sdk.list \
    && apt-get update && apt-get install -y --no-install-recommends google-cloud-cli \
    && rm -rf /var/lib/apt/lists/* \
    && gcloud --version
ENV CLOUDSDK_CORE_CUSTOM_CA_CERTS_FILE=/etc/ssl/certs/ca-certificates.crt

# --- gh ---
# GitHub CLI (gh), checksum-verified against the release's checksums.txt
RUN set -eux; \
    base=https://github.com/cli/cli/releases/download/v2.104.0; \
    tarball=gh_2.104.0_linux_arm64.tar.gz; \
    cd /tmp; \
    curl -fsSLO "$base/$tarball"; \
    curl -fsSL "$base/gh_2.104.0_checksums.txt" | grep " $tarball\$" | sha256sum -c -; \
    tar -xzf "$tarball" -C /usr/local/bin --strip-components=2 \
        "gh_2.104.0_linux_arm64/bin/gh"; \
    rm -f "$tarball"; \
    gh --version

# --- glab ---
# GitLab CLI (glab), checksum-verified against the release's checksums.txt
RUN set -eux; \
    base=https://gitlab.com/api/v4/projects/gitlab-org%2Fcli/packages/generic/glab/1.128.0; \
    file=glab_1.128.0_linux_arm64.tar.gz; \
    cd /tmp; \
    curl -fsSLO "$base/$file"; \
    curl -fsSL "$base/checksums.txt" | grep " $file\$" | sha256sum -c -; \
    tar -xzf "$file" -C /usr/local/bin --strip-components=1 bin/glab; \
    rm -f "$file"; \
    glab --version

# --- glow ---
RUN curl -fsSL https://github.com/charmbracelet/glow/releases/download/v3.0.0/glow_3.0.0_Linux_arm64.tar.gz \
        | tar -xz -C /usr/local/bin --strip-components=1 glow_3.0.0_Linux_arm64/glow \
    && chmod 755 /usr/local/bin/glow

# --- go ---
# Go toolchain. GOPATH (~/go: module cache + `go install` binaries) is in the user's home.
RUN curl -fsSL https://go.dev/dl/go1.27.3.linux-arm64.tar.gz | tar -xz -C /usr/local
ENV GOPATH=/home/dev/go \
    PATH=/usr/local/go/bin:/home/dev/go/bin:/opt/go-tools/bin:${PATH}

# --- lazydocker ---
RUN curl -fsSL https://github.com/jesseduffield/lazydocker/releases/download/v0.25.2/lazydocker_0.25.2_Linux_arm64.tar.gz \
        | tar -xz -C /usr/local/bin lazydocker \
    && chmod 755 /usr/local/bin/lazydocker

# --- lazygit ---
RUN curl -fsSL https://github.com/jesseduffield/lazygit/releases/download/v0.66.2/lazygit_0.66.2_linux_arm64.tar.gz \
        | tar -xz -C /usr/local/bin lazygit \
    && chmod 755 /usr/local/bin/lazygit

# --- starship ---
RUN curl -fsSL https://github.com/starship/starship/releases/download/v1.27.0/starship-aarch64-unknown-linux-musl.tar.gz \
        | tar -xz -C /usr/local/bin starship \
    && chmod 755 /usr/local/bin/starship

# --- terraform ---
# Terraform, checksum-verified against the release's SHA256SUMS
RUN set -eux; \
    base=https://releases.hashicorp.com/terraform/1.17.1; \
    file=terraform_1.17.1_linux_arm64.zip; \
    cd /tmp; \
    curl -fsSLO "$base/$file"; \
    curl -fsSL "$base/terraform_1.17.1_SHA256SUMS" | grep " $file\$" | sha256sum -c -; \
    unzip -o -d /usr/local/bin "$file" terraform; \
    rm -f "$file"; \
    terraform version

# --- workmux ---
RUN curl -fsSL https://github.com/raine/workmux/releases/download/v0.1.279/workmux-linux-arm64.tar.gz \
        | tar -xz -C /usr/local/bin workmux \
    && chmod 755 /usr/local/bin/workmux

# Non-root user (Ubuntu ships "ubuntu" at UID 1000; remove it)
RUN (userdel -r ubuntu 2>/dev/null || true) \
    && groupadd --gid 1000 dev \
    && useradd --uid 1000 --gid 1000 -m -s /usr/bin/fish dev \
    && usermod -aG docker dev \
    && echo "dev ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/dev \
    && chmod 0440 /etc/sudoers.d/dev \
    && true

# Directories owned by the user. Persisted ones are usually mounted as volumes; creating
# them here means Docker seeds each empty volume with the right ownership.
RUN install -d -o 1000 -g 1000 \
        /home/dev/.cache \
        /home/dev/.claude \
        /home/dev/.config \
        /home/dev/.config/acli \
        /home/dev/.config/gcloud \
        /home/dev/.config/gh \
        /home/dev/.config/git \
        /home/dev/.config/glab-cli \
        /home/dev/.local \
        /home/dev/.local/bin \
        /home/dev/.local/share \
        /home/dev/.local/state \
        /home/dev/.ssh \
        /home/dev/go \
        /workspaces
RUN chmod 700 /home/dev/.ssh

USER dev
ENV HOME=/home/dev

# --- files ---
RUN mkdir -p /home/dev/.config/fish /home/dev/.config/git
COPY --chown=1000:1000 <<'DEVC_EOF' /home/dev/.config/fish/config.fish
set -gx EDITOR vim

if status --is-interactive
    zoxide init fish | source
    starship init fish | source
    fzf --fish | source
end
DEVC_EOF
COPY --chown=1000:1000 <<'DEVC_EOF' /home/dev/.config/git/config
DEVC_EOF
COPY --chown=1000:1000 <<'DEVC_EOF' /home/dev/.tmux.conf
set -g mouse on
set-window-option -g mode-keys vi

set -g @plugin 'tmux-plugins/tpm'
set -g @plugin 'tmux-plugins/tmux-sensible'
run '~/.tmux/plugins/tpm/tpm'
DEVC_EOF
COPY --chown=1000:1000 <<'DEVC_EOF' /home/dev/.vimrc
set number
set expandtab shiftwidth=4 softtabstop=4
set ignorecase smartcase
call mkdir(expand('~/.vim/undo'), 'p')
set undofile undodir=~/.vim/undo//
DEVC_EOF

# --- base16-shell ---
RUN git clone --depth 1 https://github.com/tinted-theming/base16-shell ~/.config/base16-shell

# --- tmux ---
# TPM, plus the plugins listed with `set -g @plugin` in ~/.tmux.conf (from files)
RUN git clone --depth 1 https://github.com/tmux-plugins/tpm ~/.tmux/plugins/tpm \
    && if [ -f ~/.tmux.conf ]; then \
        tmux new-session -d -s build \
          && ~/.tmux/plugins/tpm/bin/install_plugins \
          || echo "WARNING: tmux plugin install failed; run prefix + I inside tmux"; \
        tmux kill-server 2>/dev/null || true; \
    fi

# --- vim ---
RUN set -eux; \
    mkdir -p ~/.vim/pack/bundle/start; \
    cd ~/.vim/pack/bundle/start; \
    git clone --depth 1 https://github.com/tpope/vim-sensible vim-sensible; \
    git clone --depth 1 https://github.com/fatih/vim-go vim-go
# vim-go's helper binaries (gopls, dlv, ...), built into /opt/go-tools/bin with a
# throwaway module cache so nothing lands in ~/go. Runs without your vimrc.
USER root
RUN install -d -o 1000 -g 1000 /opt/go-tools/bin
USER dev
RUN GOBIN=/opt/go-tools/bin GOMODCACHE=/tmp/gomod GOCACHE=/tmp/gocache \
        vim -N -u NONE -i NONE -E -s -c 'packloadall' -c 'GoInstallBinaries' -c 'qa!' </dev/null || true; \
    GOMODCACHE=/tmp/gomod go clean -modcache; \
    rm -rf /tmp/gocache; \
    ls /opt/go-tools/bin

USER root

# --- claude-code ---
# Claude Code: same download + SHA-256 check as https://claude.ai/install.sh, but the binary
# goes to /usr/local/bin. ADD of the channel file busts the cache whenever a new release lands
# on that channel, so a plain rebuild upgrades.
ADD https://downloads.claude.ai/claude-code-releases/stable /tmp/claude-channel-version
RUN set -eu; \
    base=https://downloads.claude.ai/claude-code-releases; \
    version="$(cat /tmp/claude-channel-version)"; \
    checksum=$(curl -fsSL "$base/$version/manifest.json" | jq -r '.platforms["linux-arm64"].checksum'); \
    curl -fsSL -o /usr/local/bin/claude "$base/$version/linux-arm64/claude"; \
    echo "$checksum  /usr/local/bin/claude" | sha256sum -c -; \
    chmod 755 /usr/local/bin/claude; \
    rm -f /tmp/claude-channel-version; \
    claude --version
# Updates come from rebuilding the image (the binary is root-owned, so auto-update can't work).
ENV DISABLE_AUTOUPDATER=1 \
    CLAUDE_CONFIG_DIR=/home/dev/.claude

WORKDIR /workspaces
COPY entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh
# Runs as dev and uses sudo to start dockerd, so `docker exec` defaults to dev too.
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
USER dev
CMD ["sleep", "infinity"]
